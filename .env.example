# LLM Provider Configuration
# Options: openai, anthropic, gemini, ollama, mistral, groq, opencode-go
LLM_PROVIDER=opencode-go

# OpenCode Go (open coding models subscription — OpenAI-compatible)
# Get your key from https://opencode.ai/auth after subscribing to Go.
# Go endpoint (paid per-token, high per-5h quotas):
#   OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
#   Models: deepseek-v4-flash, deepseek-v4-pro, gpt-5.6-luna, qwen3.7-plus, ...
# Zen free endpoint (monthly free quota — may 429 when exhausted):
#   OPENCODE_GO_BASE_URL=https://opencode.ai/zen/v1
#   Models: deepseek-v4-flash-free, mimo-v2.5-free, hy3-free, nemotron-3-ultra-free, big-pickle
OPENCODE_GO_API_KEY=your-opencode-go-key
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash-free

# Ordered fallback providers used when the primary LLM fails (rate limit/exhausted).
# Free tiers: groq (openai/gpt-oss-120b), openrouter (:free models).
LLM_BACKUP_PROVIDERS=groq,openrouter
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# Groq (free, fast inference)
GROQ_API_KEY=gsk_your-groq-key

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Mistral
MISTRAL_API_KEY=your-mistral-api-key

# Deepgram (STT)
DEEPGRAM_API_KEY=your-deepgram-key

# Bolna (webhook recording downloads — Bearer key sent to api.bolna.ai if set)
BOLNA_API_KEY=your-bolna-api-key

# STT Provider (auto-detected from available API keys if unset)
# Options: deepgram, whisper, gemini
STT_PROVIDER=

# Authentication (REQUIRED — server returns 503 if not set)
VALID_API_KEYS=your-api-key-1,your-api-key-2

# CORS (comma-separated origins, leave empty to disable CORS)
CORS_ORIGINS=

# Rate Limiting
RATE_LIMIT_RPM=60

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Data directory for local SQLite fallback
DATA_DIR=./data

# Server port
PORT=8000

# App
APP_ENV=development

# PostgreSQL (Supabase or self-hosted) — leave unset to use SQLite fallback
# DATABASE_URL=postgresql://user:password@host:5432/dbname
