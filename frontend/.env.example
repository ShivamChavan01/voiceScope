# Copy to .env.local and supply secrets through your private environment.
BACKEND_URL=http://localhost:8000
# Must match a backend VALID_API_KEYS entry. Never use NEXT_PUBLIC_* for keys.
API_KEY=
OPERATOR_AUTH_USER=
# Supply a random secret of at least 24 characters. Missing values fail closed.
OPERATOR_AUTH_PASSWORD=
STT_REVIEW_PROXY_ENABLED=false
PUBLIC_SYNTHETIC_DEMO=false
STAGING_DEMO_ONLY=false
